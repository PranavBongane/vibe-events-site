---
// src/layouts/Layout.astro
import "../styles/global.css";
import Scripts from "../components/Scripts.astro";
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html
	lang="en"
	class="[&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-none]"
>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<link
			href="https://unpkg.com/aos@2.3.1/dist/aos.css"
			rel="stylesheet"
		/>
	</head>
	<body class="relative min-h-screen">
		<!-- Ambient Background Glows -->
		<div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
			<div
				class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-red-600/10 blur-[140px]"
			>
			</div>
			<div
				class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-amber-600/10 blur-[140px]"
			>
			</div>
		</div>

		<div class="relative z-10">
			<slot />
		</div>
		<!-- Floating Contact Menu -->
		<div class="fixed bottom-6 right-6 z-50" id="contact-widget">
			<!-- Options -->
			<div
				id="contact-options"
				class="flex flex-col items-end gap-3 mb-3
		       opacity-0 translate-y-10 pointer-events-none
		       transition-all duration-300 origin-bottom"
			>
				<!-- WhatsApp -->
				<a
					href="https://wa.me/919145713890?text=Hi%20Vibe%20Events,%20I%20would%20like%20to%20inquire%20about%20an%20upcoming%20event"
					target="_blank"
					rel="noopener noreferrer"
					class="relative flex items-center justify-center w-12 h-12
			       bg-emerald-500 hover:bg-emerald-400 text-white
			       rounded-full shadow-lg transition-transform hover:scale-110"
					aria-label="Chat on WhatsApp"
				>
					<svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
						<path
							d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
						></path>
					</svg>

					<span
						class="absolute right-14 bg-slate-900 text-white
				       text-xs font-bold px-3 py-1.5 rounded-xl
				       shadow-lg opacity-0 group-hover:opacity-100
				       transition-opacity whitespace-nowrap
				       border border-slate-800 hidden sm:block"
					>
						WhatsApp Us
					</span>
				</a>

				<!-- Phone -->
				<a
					href="tel:9145713890"
					class="relative flex items-center justify-center w-12 h-12
			       bg-blue-600 hover:bg-blue-500 text-white
			       rounded-full shadow-lg transition-transform hover:scale-110"
					aria-label="Call Us"
				>
					<svg
						class="w-5 h-5"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2.5"
							d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
						></path>
					</svg>

					<span
						class="absolute right-14 bg-slate-900 text-white
				       text-xs font-bold px-3 py-1.5 rounded-xl
				       shadow-lg opacity-0 transition-opacity
				       whitespace-nowrap border border-slate-800
				       hidden sm:block"
					>
						Call Now
					</span>
				</a>
			</div>

			<!-- Main Button -->
			<button
				id="contact-trigger"
				type="button"
				class="relative flex items-center justify-center
		       w-14 h-14 bg-red-600 hover:bg-red-500
		       text-white rounded-full shadow-2xl
		       shadow-red-600/50 transition-transform
		       hover:scale-105"
				aria-label="Contact Options"
				aria-expanded="false"
			>
				<!-- Chat -->
				<svg
					id="chat-icon"
					class="w-6 h-6 transition-all duration-300 absolute"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2.5"
						d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
					></path>
				</svg>

				<!-- Close -->
				<svg
					id="close-icon"
					class="w-6 h-6 transition-all duration-300
			       scale-0 rotate-90 absolute"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2.5"
						d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>
	</body>
</html>
<Scripts />
