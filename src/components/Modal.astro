<!-- Inquiry Modal Overlay -->
<div
    id="inquiry-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md hidden transition-all duration-300"
>
    <!-- Added max-h-[90vh] overflow-y-auto and scrollbar-none utilities -->
    <div
        class="relative w-full max-w-2xl max-h-[90vh] overflow-y-auto [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none] glass-card p-8 md:p-12 rounded-3xl border border-slate-800 shadow-2xl bg-slate-900/90"
    >
        <!-- Close Button -->
        <button
            id="close-modal-btn"
            class="absolute top-6 right-6 text-slate-400 hover:text-white text-2xl font-bold w-10 h-10 flex items-center justify-center rounded-full bg-slate-800/50 hover:bg-slate-800 transition-colors"
        >
            &times;
        </button>

        <div class="text-center max-w-lg mx-auto mb-8">
            <span
                class="text-xs font-black uppercase tracking-widest text-red-500 mb-2 block"
                >Get In Touch</span
            >
            <h2 class="text-2xl md:text-4xl font-black mb-2">
                Start Planning Your Event
            </h2>
            <p class="text-slate-400 text-sm">
                Complete our quick event blueprint wizard below to check
                availability.
            </p>
        </div>

        <form
            id="inquiry-form"
            class="space-y-6"
            action="https://formsubmit.co/vibeevents07@gmail.com"
            method="POST"
        >
            <!-- Step 1: Event Type -->
            <div class="space-y-3">
                <label
                    class="block text-xs font-bold text-slate-300 uppercase tracking-wider"
                    >1. Select Event Type</label
                >
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <label class="cursor-pointer">
                        <input
                            type="radio"
                            name="event_type"
                            value="Product Launch"
                            class="peer sr-only"
                            required
                        />
                        <div
                            class="p-4 rounded-2xl border border-slate-800 bg-slate-900/50 peer-checked:border-red-600 peer-checked:bg-red-600/10 hover:border-slate-700 transition-all text-center"
                        >
                            <span class="block font-bold text-white text-xs"
                                >Product Launch</span
                            >
                        </div>
                    </label>
                    <label class="cursor-pointer">
                        <input
                            type="radio"
                            name="event_type"
                            value="Corporate Conference"
                            class="peer sr-only"
                        />
                        <div
                            class="p-4 rounded-2xl border border-slate-800 bg-slate-900/50 peer-checked:border-red-600 peer-checked:bg-red-600/10 hover:border-slate-700 transition-all text-center"
                        >
                            <span class="block font-bold text-white text-xs"
                                >Corporate Event</span
                            >
                        </div>
                    </label>
                    <label class="cursor-pointer">
                        <input
                            type="radio"
                            name="event_type"
                            value="Luxury Wedding"
                            class="peer sr-only"
                        />
                        <div
                            class="p-4 rounded-2xl border border-slate-800 bg-slate-900/50 peer-checked:border-red-600 peer-checked:bg-red-600/10 hover:border-slate-700 transition-all text-center"
                        >
                            <span class="block font-bold text-white text-xs"
                                >Luxury Wedding</span
                            >
                        </div>
                    </label>
                </div>
            </div>

            <!-- Step 2: Estimated Scale -->
            <div class="space-y-3">
                <label
                    class="block text-xs font-bold text-slate-300 uppercase tracking-wider"
                    >2. Expected Guest Scale</label
                >
                <select
                    name="guest_scale"
                    class="w-full bg-slate-900 border border-slate-800 rounded-2xl p-3.5 text-white text-sm focus:outline-none focus:border-red-500 transition-colors"
                >
                    <option value="50-150">Intimate (50 - 150 Guests)</option>
                    <option value="150-500">Mid Scale (150 - 500 Guests)</option
                    >
                    <option value="500+">Grand Scale (500+ Guests)</option>
                </select>
            </div>

            <!-- Step 3: Contact Info -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                    <label
                        class="block text-[10px] font-bold text-slate-400 uppercase"
                        >Your Name</label
                    >
                    <input
                        type="text"
                        name="name"
                        placeholder="John Doe"
                        required
                        class="w-full bg-slate-900 border border-slate-800 rounded-2xl p-3.5 text-white text-sm focus:outline-none focus:border-red-500 transition-colors"
                    />
                </div>
               <div class="space-y-1.5">
                    <label
                        class="block text-[10px] font-bold text-slate-400 uppercase"
                        >Phone Number</label
                    >
                    <input
                        type="tel"
                        name="phone"
                        placeholder="+91 98765 43210"
                        required
                        class="w-full bg-slate-900 border border-slate-800 rounded-2xl p-3.5 text-white text-sm focus:outline-none focus:border-red-500 transition-colors"
                    />
                </div>
            </div>
           

            <div class="space-y-1.5">
                <label
                    class="block text-[10px] font-bold text-slate-400 uppercase"
                    >Project Vision / Details</label
                >
                <textarea
                    name="message"
                    rows="3"
                    placeholder="Tell us about your venue, goals, and target date..."
                    class="w-full bg-slate-900 border border-slate-800 rounded-2xl p-3.5 text-white text-sm focus:outline-none focus:border-red-500 transition-colors"
                ></textarea>
            </div>

            <button
                type="submit"
                class="w-full py-4 bg-red-600 hover:bg-red-500 text-white font-extrabold rounded-2xl shadow-xl shadow-red-600/30 transition-all hover:scale-[1.01] uppercase tracking-wider text-xs"
            >
                Submit Blueprint Inquiry &rarr;
            </button>
        </form>
    </div>
</div>
