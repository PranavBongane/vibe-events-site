<section class="py-12 bg-slate-900/60 border-y border-slate-800">
    <div
        class="max-w-7xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-8 text-center"
    >
        <div data-aos="fade-up">
            <p class="text-4xl font-black text-red-500 mb-1">
                <span class="stat-counter" data-target="1000">0</span>+
            </p>
            <p
                class="text-xs font-bold text-slate-400 uppercase tracking-widest"
            >
                Tailored Projects
            </p>
        </div>
        <div data-aos="fade-up" data-aos-delay="100">
            <p class="text-4xl font-black text-amber-500 mb-1">
                <span class="stat-counter" data-target="8">0</span>+ Years
            </p>
            <p
                class="text-xs font-bold text-slate-400 uppercase tracking-widest"
            >
                Industry Experience
            </p>
        </div>
        <div data-aos="fade-up" data-aos-delay="200">
            <p class="text-4xl font-black text-red-500 mb-1">
                <span class="stat-counter" data-target="200">0</span>+
            </p>
            <p
                class="text-xs font-bold text-slate-400 uppercase tracking-widest"
            >
                Brand Partners
            </p>
        </div>
        <div data-aos="fade-up" data-aos-delay="300">
            <p class="text-4xl font-black text-amber-500 mb-1">
                <span class="stat-counter" data-target="300">0</span>+
            </p>
            <p
                class="text-xs font-bold text-slate-400 uppercase tracking-widest"
            >
                Trusted Vendors
            </p>
        </div>
    </div>
</section>
