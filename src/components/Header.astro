---
// src/components/Header.astro
---
<header class="fixed top-0 w-full z-50 glass-card border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <!-- Brand Logo -->
        <a href="/" class="text-2xl font-black tracking-wider text-white flex items-center gap-2">
            <span class="bg-red-600 text-white px-2 py-1 rounded shadow-lg shadow-red-600/30">V</span> VIBE EVENTS
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-8">
            <a href="/#portfolio" class="text-sm font-bold text-slate-300 hover:text-white transition-colors">Portfolio</a>
            <a href="/#services" class="text-sm font-bold text-slate-300 hover:text-white transition-colors">Services</a>
            <a href="/#clients" class="text-sm font-bold text-slate-300 hover:text-white transition-colors">Clients</a>
            <a href="/#testimonials" class="text-sm font-bold text-slate-300 hover:text-white transition-colors">Testimonials</a>
            <a href="/gallery" class="text-sm font-bold text-slate-300 hover:text-red-500 transition-colors">Event Gallery</a>
        </nav>

        <!-- Desktop CTA Button -->
        <div class="hidden md:block">
            <a href="/#contact" class="px-5 py-2.5 rounded-full bg-red-600 hover:bg-red-500 text-white font-bold text-sm tracking-wider uppercase transition-all shadow-lg shadow-red-600/30">
                Let's Talk
            </a>
        </div>

        <!-- Mobile Hamburger Button (Visible on small screens) -->
        <button 
            id="mobile-menu-btn" 
            class="md:hidden text-slate-300 hover:text-white focus:outline-none p-2"
            aria-label="Toggle Menu"
        >
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>

    <!-- Mobile Dropdown Menu Drawer -->
    <div id="mobile-menu" class="hidden md:hidden glass-card border-b border-slate-800 bg-slate-950/95 px-6 py-6 space-y-4 shadow-2xl">
        <nav class="flex flex-col space-y-4">
            <a href="/#portfolio" class="mobile-link text-base font-bold text-slate-300 hover:text-red-500 transition-colors">Portfolio</a>
            <a href="/#services" class="mobile-link text-base font-bold text-slate-300 hover:text-red-500 transition-colors">Services</a>
            <a href="/#clients" class="mobile-link text-base font-bold text-slate-300 hover:text-red-500 transition-colors">Clients</a>
            <a href="/#testimonials" class="mobile-link text-base font-bold text-slate-300 hover:text-red-500 transition-colors">Testimonials</a>
            <a href="/gallery" class="mobile-link text-base font-bold text-slate-300 hover:text-red-500 transition-colors">Event Gallery</a>
        </nav>
        <div class="pt-4 border-t border-slate-800">
            <a href="/#contact" class="mobile-link block w-full text-center py-3 rounded-full bg-red-600 hover:bg-red-500 text-white font-bold text-sm tracking-wider uppercase transition-all shadow-lg shadow-red-600/30">
                Let's Talk
            </a>
        </div>
    </div>
</header>

