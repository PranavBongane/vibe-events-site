---
// src/components/Header.astro
---
<header class="fixed top-0 w-full z-50 glass-card border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <!-- Brand Logo -->
         <a
            href="/#"
            class="text-2xl font-black tracking-wider text-white flex items-center gap-2"
        >
            <img
                src="/logo.png"
                alt="Vibe Events Logo"
                class="w-8 h-8 rounded object-cover shadow-md shadow-red-600/30"
            />
            VIBE EVENTS
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-8">
            <a href="/gallery" class="hover:text-red-400 transition-colors">Our Work</a>
            <a href="/#services" class="hover:text-red-400 transition-colors">Services</a>
            <a href="/#clients" class="hover:text-red-400 transition-colors">Clients</a>
            <a href="https://www.instagram.com/vibe_events__?igsh=OTBoM2hjOHkyOW9p" target="_blank" class="hover:text-red-400 transition-colors">Instagram</a>
            <a href="https://m.youtube.com/@vibeevents07" target="_blank" class="hover:text-red-400 transition-colors">YouTube</a>
        </nav>

        <!-- Desktop CTA -->
        <div class="hidden md:block">
            <button id="open-modal-btn" class="px-5 py-2.5 rounded-full bg-linear-to-r from-red-600 to-amber-500 hover:opacity-90 text-white font-bold text-sm transition-all shadow-lg shadow-red-600/30 cursor-pointer">
                Let's Talk &rarr;
            </button>
        </div>

        <!-- Mobile Hamburger Button -->
        <button 
            id="mobile-menu-btn" 
            class="md:hidden text-slate-300 hover:text-white focus:outline-none p-2 cursor-pointer"
            aria-label="Toggle Menu"
        >
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>

    <!-- Mobile Dropdown Menu Drawer -->
    <div id="mobile-menu" class="hidden md:hidden glass-card border-b border-slate-800 bg-slate-950/95 px-6 py-6 space-y-4 shadow-2xl">
        <nav class="flex flex-col space-y-4">
            <a href="/gallery" class="mobile-nav-link hover:text-red-400 transition-colors">Our Work</a>
            <a href="/#services" class="mobile-nav-link hover:text-red-400 transition-colors">Services</a>
            <a href="/#clients" class="mobile-nav-link hover:text-red-400 transition-colors">Clients</a>
            <a href="https://www.instagram.com/vibe_events__?igsh=OTBoM2hjOHkyOW9p" target="_blank" class="mobile-nav-link hover:text-red-400 transition-colors">Instagram</a>
            <a href="https://m.youtube.com/@vibeevents07" target="_blank" class="mobile-nav-link hover:text-red-400 transition-colors">YouTube</a>
        </nav>
        <div class="pt-2">
            <button id="mobile-open-modal-btn" class="w-full px-5 py-3 rounded-full bg-linear-to-r from-red-600 to-amber-500 text-white font-bold text-sm transition-all shadow-lg shadow-red-600/30 cursor-pointer">
                Let's Talk &rarr;
            </button>
        </div>
    </div>
</header>

