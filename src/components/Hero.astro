---

---

<section
    class="relative min-h-svh py-24 flex items-center justify-center overflow-hidden"
>
    <div class="absolute inset-0 z-0">
        <video
            autoplay
            muted
            loop
            playsinline
            class="w-full h-full object-cover opacity-40 scale-105"
        >
            <source src="/event-loop.mp4" type="video/mp4" />
        </video>
        <div
            class="absolute inset-0 bg-linear-to-b from-slate-950/80 via-slate-950/50 to-slate-950"
        >
        </div>
    </div>
    <div
        class="relative z-10 max-w-5xl mx-auto px-6 text-center"
        data-aos="fade-up"
    >
        <span
            class="text-xs font-black uppercase tracking-[0.3em] px-4 py-1.5 rounded-full bg-red-600/20 text-red-500 border border-red-500/30 mb-6 inline-block"
        >
            Elite Event Production & Design
        </span>
        <h1
            class="text-4xl md:text-7xl font-black text-white tracking-tight mb-6 leading-tight"
            data-aos="fade-up"
            data-aos-duration="1000"
        >
            we create <span
                class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-amber-400 to-red-500 animate-gradient-text"
            >
                you celebrate</span
            >.
        </h1>
        <p
            class="text-lg md:text-xl text-slate-300 max-w-2xl mx-auto mb-7 leading-relaxed"
        >
            From high-octane corporate product launches to ultra-luxury
            destination celebrations, we engineer moments that leave lasting
            impressions.
        </p>

        <!-- Project cards -->
        <div
            class="mb-3 grid grid-cols-1 sm:grid-cols-2 gap-4 w-full max-w-3xl mx-auto"
            data-aos="fade-up"
            data-aos-delay="200"
        >
            <!-- Card 1: Corporate Events -->
            <a
                href="#CORPORATE_EXPERIENCES"
                class="group relative h-32 sm:h-56 w-full rounded-3xl overflow-hidden glass-card border border-slate-800 hover:border-red-500/50 transition-all block"
            >
                <!-- Background Image -->
                <img
                    src="https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=600&q=80"
                    alt="Corporate Events"
                    class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:opacity-70 group-hover:scale-110 transition-transform duration-700"
                />
                <!-- Dark Gradient Overlay -->
                <div
                    class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent"
                >
                </div>

                <!-- Text Content -->
                <div
                    class="absolute bottom-0 left-0 w-full p-5 sm:p-6 text-left"
                >
                    <h3
                        class="text-lg sm:text-2xl font-black text-white group-hover:text-red-400 transition-colors leading-tight"
                    >
                        Corporate Events
                    </h3>
                    <p
                        class="text-[10px] sm:text-xs font-bold text-slate-400 tracking-widest uppercase mt-1 sm:mt-2 flex items-center gap-2"
                    >
                        View Productions <span
                            class="group-hover:translate-x-1 transition-transform"
                            >&rarr;</span
                        >
                    </p>
                </div>
            </a>

            <!-- Card 2: Luxury Weddings -->
            <a
                href="#ELEGANT_WEDDINGS"
                class="group relative h-32 sm:h-56 w-full rounded-3xl overflow-hidden glass-card border border-slate-800 hover:border-amber-500/50 transition-all block"
            >
                <!-- Background Image -->
                <img
                    src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=600&q=80"
                    alt="Luxury Weddings"
                    class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:opacity-70 group-hover:scale-110 transition-transform duration-700"
                />
                <!-- Dark Gradient Overlay -->
                <div
                    class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent"
                >
                </div>

                <!-- Text Content -->
                <div
                    class="absolute bottom-0 left-0 w-full p-5 sm:p-6 text-left"
                >
                    <h3
                        class="text-lg sm:text-2xl font-black text-white group-hover:text-amber-400 transition-colors leading-tight"
                    >
                        Elegant Weddings
                    </h3>
                    <p
                        class="text-[10px] sm:text-xs font-bold text-slate-400 tracking-widest uppercase mt-1 sm:mt-2 flex items-center gap-2"
                    >
                        View Weddings <span
                            class="group-hover:translate-x-1 transition-transform"
                            >&rarr;</span
                        >
                    </p>
                </div>
            </a>
        </div>

        <!-- Instgram C To A -->
        <div
            class="flex flex-col sm:flex-row justify-center gap-4"
            data-aos="fade-up"
            data-aos-delay="200"
        >
            <a
                href="https://www.instagram.com/vibe_events__?igsh=OTBoM2hjOHkyOW9p"
                target="_blank"
                class="px-8 py-4 inset-0 bg-gradient-to-r from-red-600 to-amber-500 opacity-100 rounded-full text-white font-black tracking-wider uppercase transition-all text-center border border-slate-700 flex items-center justify-center gap-2"
            >
                📸 Watch Reels on Instagram
            </a>
        </div>
    </div>
</section>
