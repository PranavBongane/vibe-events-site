---
import { portfolioHighlights } from "../data/projects";
const corporateWork = portfolioHighlights.filter(
    (item) =>
        item.category.includes("Corporate") || item.category.includes("Launch"),
);
const weddingWork = portfolioHighlights.filter((item) =>
    item.category.includes("Wedding"),
);
---

<div id="work" class="space-y-32 max-w-7xl mx-auto px-6 mb-4 overflow-visible pt-12">
    <!-- Corporate Showcase -->
    <div id="CORPORATE_EXPERIENCES" class="relative pt-32">
        <div class="text-center mb-16">
            <h2
                class="text-red-500 font-bold uppercase tracking-widest text-sm mb-2"
                data-aos="fade-up"
            >
                Brand Activations
            </h2>
            <h3
                class="text-4xl md:text-5xl font-black text-white"
                data-aos="fade-up"
                data-aos-delay="100"
            >
                CORPORATE <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-amber-500"
                    >EVENTS</span
                >
            </h3>
        </div>

        <div
            class="coverflow-container relative w-full h-[250px] md:h-[350px] flex justify-center items-center"
        >
            <div
                class="coverflow relative w-full h-full flex justify-center items-center"
                id="corporate-coverflow"
            >
                {
                    corporateWork.map((item, index) => (
                        <div
                            class={`cover-card absolute w-[300px] h-[200px] md:w-[500px] md:h-[300px] rounded-3xl overflow-hidden cursor-pointer shadow-2xl transition-all duration-500 border border-slate-800 ${index === 0 ? "active" : ""}`}
                        >
                            <img
                                src={item.image}
                                alt={item.title}
                                class="card-img w-full h-full object-cover pointer-events-none transition-opacity duration-500"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent pointer-events-none" />
                            <div class="text-content absolute bottom-0 left-0 w-full p-6 text-left pointer-events-none transition-opacity duration-500">
                                <span class="text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full bg-red-600 text-white mb-2 inline-block shadow-lg">
                                    {item.category}
                                </span>
                                <h4 class="text-xl md:text-2xl font-black text-white leading-tight drop-shadow-md">
                                    {item.title}
                                </h4>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
     <!-- Gallery Call to Action -->
    <div class="flex justify-center pt-1 pb-12" data-aos="fade-up">
        <a 
            href="/gallery" 
            class="group relative inline-flex items-center justify-center px-10 py-4 font-black tracking-widest text-white uppercase transition-all duration-300 bg-slate-900 border border-slate-700 rounded-full hover:border-red-500 overflow-hidden shadow-2xl shadow-red-600/10"
        >
            <!-- Hover Gradient Background -->
            <div class="absolute inset-0 bg-gradient-to-r from-red-600 to-amber-500 opacity-100 group-hover:opacity-100 transition-opacity duration-300"></div>
            
            <!-- Button Text -->
            <span class="relative z-10 flex items-center gap-3">
                View Full Gallery 
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </span>
        </a>
    </div>

    <!-- Weddings Showcase -->
    <div id="ELEGANT_WEDDINGS" class="relative pt-32">
        <div class="text-center mb-16">
            <h2
                class="text-amber-500 font-bold uppercase tracking-widest text-sm mb-2"
                data-aos="fade-up"
            >
                Private Events
            </h2>
            <h3
                class="text-4xl md:text-5xl font-black text-white"
                data-aos="fade-up"
                data-aos-delay="100"
            >
                ELEGANT <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-amber-500 to-yellow-300"
                    >WEDDINGS</span
                >
            </h3>
        </div>

        <div
            class="coverflow-container relative w-full h-[250px] md:h-[350px] flex justify-center items-center"
        >
            <div
                class="coverflow relative w-full h-full flex justify-center items-center"
                id="wedding-coverflow"
            >
                {
                    weddingWork.map((item, index) => (
                        <div
                            class={`cover-card absolute w-[300px] h-[200px] md:w-[500px] md:h-[300px] rounded-3xl overflow-hidden cursor-pointer shadow-2xl transition-all duration-500 border border-slate-800 ${index === 0 ? "active" : ""}`}
                        >
                            <img
                                src={item.image}
                                alt={item.title}
                                class="card-img w-full h-full object-cover pointer-events-none transition-opacity duration-500"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent pointer-events-none" />
                            <div class="text-content absolute bottom-0 left-0 w-full p-6 text-left pointer-events-none transition-opacity duration-500">
                                <span class="text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full bg-amber-500 text-black mb-2 inline-block shadow-lg">
                                    {item.category}
                                </span>
                                <h4 class="text-xl md:text-2xl font-black text-white leading-tight drop-shadow-md">
                                    {item.title}
                                </h4>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>

    <!-- Gallery Call to Action -->
    <div class="flex justify-center pt-1 pb-12" data-aos="fade-up">
        <a 
            href="/gallery" 
            class="group relative inline-flex items-center justify-center px-10 py-4 font-black tracking-widest text-white uppercase transition-all duration-300 bg-slate-900 border border-slate-700 rounded-full hover:border-red-500 overflow-hidden shadow-2xl shadow-red-600/10"
        >
            <!-- Hover Gradient Background -->
            <div class="absolute inset-0 bg-gradient-to-r from-red-600 to-amber-500 opacity-100 group-hover:opacity-100 transition-opacity duration-300"></div>
            
            <!-- Button Text -->
            <span class="relative z-10 flex items-center gap-3">
                View Full Gallery 
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </span>
        </a>
    </div>
</div>