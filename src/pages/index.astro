---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro"; // Assuming you abstract the header too!
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import Portfolio from "../components/Portfolio.astro";
import Services from "../components/Services.astro";
import Clients from "../components/Clients.astro";
import Testimonials from "../components/Testimonials.astro";
import SocialBanner from "../components/SocialBanner.astro";
import Contact from "../components/Contact.astro";
import Modal from "../components/Modal.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Vibe Events | We create - You Celebrate">
	<Header />

	<main class="pb-24 min-h-screen">
		<Hero />
		<Stats />
		<Portfolio />
		<Services />
		<Clients />
		<Testimonials />
		<SocialBanner />
		<Contact />
	</main>

	<Footer />
	<Modal />
</Layout>
