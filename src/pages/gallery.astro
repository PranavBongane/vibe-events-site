---
// src/pages/gallery.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro"; 
import Footer from "../components/Footer.astro"; 

// Import the unified data source!
import { allEvents } from "../data/projects";

// Dynamically generate the filter buttons based on the categories in your data
const categories = ["All", ...new Set(allEvents.map(event => event.category))];
---

<Layout title="Our Work | Vibe Events">
    <Header />

    <main class="pt-32 pb-24 min-h-screen">
        <div class="max-w-7xl mx-auto px-6 text-center mb-16">
            <h1 class="text-xs font-black uppercase tracking-[0.3em] text-red-500 mb-4" data-aos="fade-up">
                The Gallery
            </h1>
            <h2 class="text-4xl md:text-6xl font-black text-white tracking-tight mb-6" data-aos="fade-up" data-aos-delay="100">
                MASTERPIECES IN <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-amber-500">MOTION</span>
            </h2>
        </div>

        <!-- Filter Controls -->
        <div class="max-w-7xl mx-auto px-6 mb-12" data-aos="fade-up" data-aos-delay="300">
            <div class="flex flex-wrap justify-center gap-3">
                {categories.map((category, index) => (
                    <button 
                        class={`filter-btn px-6 py-2 rounded-full text-xs font-bold uppercase tracking-wider transition-all border ${index === 0 ? 'bg-red-600 border-red-500 text-white shadow-lg shadow-red-600/30' : 'bg-slate-900 border-slate-700 text-slate-400 hover:text-white hover:border-slate-500'}`}
                        data-target={category}
                    >
                        {category}
                    </button>
                ))}
            </div>
        </div>

        <!-- Gallery Grid -->
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="gallery-grid">
                {allEvents.map((item) => (
                   
                    <a
                        href={`/work/${item.id}`}
                        class="gallery-item group relative h-80 rounded-3xl overflow-hidden glass-card border border-slate-800 block transition-all duration-500 transform scale-100 opacity-100"
                        data-category={item.category}
                    >
                        <img
                            src={item.image}
                            alt={item.title}
                            class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 opacity-60 group-hover:opacity-80"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent" />
                        
                        <div class="absolute bottom-0 left-0 w-full p-6 text-left">
                            <span class="text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full bg-slate-800/80 backdrop-blur-md border border-slate-600 text-white mb-3 inline-block shadow-lg">
                                {item.category}
                            </span>
                            <h3 class="text-xl md:text-2xl font-black text-white group-hover:text-red-400 transition-colors leading-tight drop-shadow-md">
                                {item.title}
                            </h3>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </main>

    <Footer />
</Layout>

