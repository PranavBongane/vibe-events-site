---
// src/pages/work/[id].astro
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";

export async function getStaticPaths() {
    return projects.map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} | Vibe Events`}>
    <header
        class="fixed top-0 w-full z-50 glass-card border-b border-slate-800/80"
    >
        <div
            class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between"
        >
            <a
                href="/"
                class="text-2xl font-black tracking-wider text-white flex items-center gap-2"
            >
                <span class="bg-red-600 text-white px-2 py-1 rounded">V</span> VIBE
                EVENTS
            </a>
            <a
                href="/#work"
                class="text-sm font-bold text-slate-300 hover:text-white transition-colors"
            >
                &larr; Back to Home
            </a>
        </div>
    </header>

    <main class="pt-32 pb-24 max-w-5xl mx-auto px-6">
        <div class="mb-8" data-aos="fade-down">
            <span
                class="text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full bg-red-600 text-white mb-4 inline-block"
            >
                {project.category}
            </span>
            <h1 class="text-4xl md:text-6xl font-black mb-4">
                {project.title}
            </h1>
            <p class="text-slate-400 text-lg">
                Client Partner: <span class="text-white font-bold"
                    >{project.client}</span
                >
            </p>
        </div>

        <div
            class="h-[400px] md:h-[550px] rounded-3xl overflow-hidden mb-12 glass-card border border-slate-800"
            data-aos="fade-up"
        >
            <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover"
            />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
            <div class="md:col-span-2 space-y-6" data-aos="fade-up">
                <h3 class="text-2xl font-bold">Project Overview</h3>
                <p class="text-slate-300 leading-relaxed text-base">
                    {project.description}
                </p>
            </div>

            <div
                class="glass-card p-6 rounded-3xl border border-slate-800 h-fit"
                data-aos="fade-up"
                data-aos-delay="100"
            >
                <h4 class="text-lg font-bold mb-4 text-red-500">
                    Key Highlights
                </h4>
                <ul class="space-y-3">
                    {
                        project.highlights.map((item) => (
                            <li class="flex items-center gap-2 text-sm text-slate-300">
                                <span class="w-1.5 h-1.5 rounded-full bg-red-500" />
                                {item}
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>

        <div class="mt-16 text-center border-t border-slate-800 pt-12">
            <a
                href="/#contact"
                class="px-8 py-4 rounded-full bg-red-600 hover:bg-red-500 text-white font-black tracking-wider uppercase transition-all shadow-xl shadow-red-600/30 inline-block"
            >
                Inquire About a Similar Event
            </a>
        </div>
    </main>
</Layout>
